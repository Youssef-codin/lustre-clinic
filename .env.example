# Only non-user-editable values live here (SPEC §12).
# Everything configurable by the clinic is a database row edited in-app.

DATABASE_URL=postgres://mawid:mawid@localhost:5432/mawid
POSTGRES_PASSWORD=mawid
PORT=3000
LOG_LEVEL=info

# Bind address for the published server port. In production this is the
# clinic machine's Tailscale IP so nothing listens on the LAN or WAN.
TAILSCALE_IP=0.0.0.0

# Monitoring (SPEC §17) — the app posting its own failures.
DISCORD_WEBHOOK_URL=

# Backups (SPEC §16). This key is NOT stored on the clinic machine.
BACKUP_ENCRYPTION_KEY=
