# Only non-user-editable values live here (SPEC §12).
# Everything configurable by the clinic is a database row edited in-app.

DATABASE_URL=postgres://mawid:mawid@localhost:5432/mawid
POSTGRES_PASSWORD=mawid
PORT=3000
LOG_LEVEL=info

# Bind address for the published server port. In production this is the
# clinic machine's Tailscale IP so nothing listens on the LAN or WAN.
TAILSCALE_IP=0.0.0.0

# Monitoring (SPEC §17) — the app posting its own failures.
DISCORD_WEBHOOK_URL=

# External liveness check (§17). Nothing can reach the clinic machine from
# outside the tailnet, so the server pings out and the monitor alerts on
# silence. An UptimeRobot heartbeat URL, or any equivalent.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=300

# Backups (SPEC §16). This key is NOT stored on the clinic machine — it lives
# with the operator, and off-site upload is refused without it. 32 bytes, hex or
# base64. Generate one with:
#   bun -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_STALE_AFTER_HOURS=48

# Off-site destination (§16). Uploads are skipped when the bucket is unset.
# Google Drive is the intended destination; a service-account uploader lands in
# a follow-up and will replace these.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=mawid
