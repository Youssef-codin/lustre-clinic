{
    "name": "mawid",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun --watch packages/server/src/index.ts",
        "start": "bun packages/server/src/index.ts",
        "typecheck": "bun run --filter '*' typecheck",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "LOG_LEVEL=silent bun test",
        "app": "bun run --cwd packages/app device",
        "app:build": "bun run --cwd packages/app device:build",
        "db:generate": "bun run --cwd packages/server db:generate",
        "db:migrate": "bun packages/server/scripts/migrate.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@types/bun": "^1.3.14",
        "typescript": "^5.9.3"
    }
}
