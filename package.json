{
    "name": "mawid",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --filter '*' dev",
        "build": "bun run --cwd packages/web build && bun run --cwd packages/server build",
        "typecheck": "bun run --filter '*' typecheck",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "LOG_LEVEL=silent bun test",
        "seed": "bun run --cwd packages/server seed",
        "sample-print": "bun run --cwd packages/server sample-print",
        "print-patient": "bun run --cwd packages/server print-patient"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@types/bun": "^1.3.14",
        "typescript": "^5.9.3"
    }
}
