{
    "name": "mawid",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun --watch packages/server/src/index.ts",
        "start": "bun packages/server/src/index.ts",
        "typecheck": "bun run --filter '*' typecheck",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "bun test",
        "app": "bun run --cwd packages/app device",
        "app:build": "bun run --cwd packages/app device:build",
        "app:stop": "bun run --cwd packages/app device:stop",
        "emu": "bun run --cwd packages/app emu",
        "emu:build": "bun run --cwd packages/app emu:build",
        "emu:start": "bun run --cwd packages/app emu:start",
        "emu:shot": "bun run --cwd packages/app emu:shot",
        "db:generate": "bun run --cwd packages/server db:generate",
        "db:migrate": "bun packages/server/scripts/migrate.ts",
        "db:seed": "bun packages/server/scripts/seed.ts",
        "backup": "bun packages/server/scripts/backup.ts",
        "restore": "bun packages/server/scripts/restore.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@types/bun": "^1.3.14",
        "typescript": "^5.9.3"
    }
}
