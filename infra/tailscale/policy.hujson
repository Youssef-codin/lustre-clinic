// Access policy for the clinic tailnet (lustre.clinics.<clinic>@gmail.com).
//
// The host firewall accepts anything arriving on tailscale0 (see
// nftables.conf.j2), so this file is the only thing deciding which device may
// reach which port. Every machine is logged in as the same Google account, so
// identity cannot separate them: the server carries a tag and the phones are
// named by their Tailscale IP, which does not change once assigned.
//
// Paste into the admin console: Access controls -> Edit -> Save.
{
	"tagOwners": {
		// Only the clinic account may tag a machine as the server.
		"tag:clinic-server": ["autogroup:owner"],
		// The phones, tagged from the Machines page (Edit ACL tags). A tag
		// covers both of a device's addresses and survives an address change,
		// and a tagged device's key does not expire.
		"tag:clinic-phone":  ["autogroup:owner"],
		"tag:test-phone":    ["autogroup:owner"],
	},

	"hosts": {
		// From the admin console's Machines page. A phone that is removed and
		// re-added gets new addresses: update them here, or it loses access.
		//
		// Each machine has an IPv4 and an IPv6 address, and a host names only
		// one, so both are listed. The phones' tags make these redundant once
		// every phone carries one.
		"smilemakers":     "100.125.78.21",
		"archbtw":         "100.122.204.107",
		"archbtw-6":       "fd7a:115c:a1e0::535:cc6d",
		"mha-l29":         "100.74.199.126",
		"mha-l29-6":       "fd7a:115c:a1e0::8b35:c77f",
		"oneplus-open":    "100.100.9.7",
		"oneplus-open-6":  "fd7a:115c:a1e0::3335:908",
		"test-android":    "100.114.57.43",
		"test-android-6":  "fd7a:115c:a1e0::8f35:392f",
	},

	"acls": [
		// The doctor's and the assistant's phones: the production API, and
		// GlitchTip because release builds send their crash reports there (the
		// DSN names :8000). User signup is off in GlitchTip, so all a phone
		// can reach there is the ingest endpoint and a login page. Not SSH,
		// not the dev stack.
		{
			"action": "accept",
			"src":    ["tag:clinic-phone", "mha-l29", "mha-l29-6", "oneplus-open", "oneplus-open-6"],
			"dst":    ["tag:clinic-server:3000,8000"],
		},

		// The operator's phone: the dev stack, and for now production too, so a
		// release can be checked the way the doctor sees it. That puts real
		// patient records on it: losing it is losing a clinic phone. Drop
		// 3000,8000 here to take it back to dev only. Never SSH.
		{
			"action": "accept",
			"src":    ["tag:test-phone", "test-android", "test-android-6"],
			"dst":    ["tag:clinic-server:3000,3001,8000"],
		},

		// The operator's machine: everything it needs to run the plays, read
		// GlitchTip, and pull backups. SSH included.
		{
			"action": "accept",
			"src":    ["archbtw", "archbtw-6"],
			"dst":    ["tag:clinic-server:22,3000,3001,8000"],
		},

		// The server starts nothing towards the phones; it only answers them.
	],

	// SSH over the tailnet reaches the real sshd (the plays turn Tailscale SSH
	// off), so no ssh{} rules belong here. Adding any would put Tailscale back
	// in the login path.

	"tests": [
		{
			"src":    "mha-l29",
			"accept": ["tag:clinic-server:3000", "tag:clinic-server:8000"],
			"deny":   ["tag:clinic-server:22", "tag:clinic-server:3001", "oneplus-open:1", "archbtw:22"],
		},
		{
			"src":    "oneplus-open",
			"accept": ["tag:clinic-server:3000", "tag:clinic-server:8000"],
			"deny":   ["tag:clinic-server:22", "tag:clinic-server:3001", "mha-l29:1", "archbtw:22"],
		},
		{
			"src":    "test-android",
			"accept": ["tag:clinic-server:3000", "tag:clinic-server:3001", "tag:clinic-server:8000"],
			"deny":   ["tag:clinic-server:22", "mha-l29:1", "archbtw:22"],
		},
		{
			"src":    "archbtw",
			"accept": ["tag:clinic-server:22", "tag:clinic-server:8000"],
		},
	],
}
