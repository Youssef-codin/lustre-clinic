# Managed by infra/ansible (tasks/app.yml) and rendered on every deploy. The
# passwords are carried over from the previous file, because the database
# volume was created with them; edit anything else in the inventory instead.
#
# COMPOSE_PROJECT_NAME makes a bare `docker compose` in this directory act on
# this stack and no other.
COMPOSE_PROJECT_NAME=lustre-{{ stack.name }}
LUSTRE_ENVIRONMENT={{ stack.environment }}

POSTGRES_PASSWORD={{ stack_secrets.superuser }}
LUSTRE_OWNER_PASSWORD={{ stack_secrets.owner }}
LUSTRE_APP_PASSWORD={{ stack_secrets.app }}

MIGRATE_ON_BOOT={{ stack.migrate_on_boot | string | lower }}
{% if stack.migrate_on_boot %}
SERVER_MIGRATION_DATABASE_URL=postgres://lustre_owner:{{ stack_secrets.owner }}@db:5432/lustre
{% else %}
# Empty on purpose: the running server never holds the owner's password.
SERVER_MIGRATION_DATABASE_URL=
{% endif %}

API_PORT={{ stack.api_port }}
DB_PORT={{ stack.db_port }}
LOG_LEVEL=info

TAILSCALE_IP={{ stack_ts_ip }}
TAILSCALE_HOSTNAME={{ stack_ts_dns }}
DISCORD_WEBHOOK_URL={{ stack_urls.discord }}
HEARTBEAT_URL={{ stack_urls.heartbeat }}

COMPOSE_PROFILES={{ 'glitchtip' if stack.glitchtip else '' }}
# compose.yaml requires these even when the profile is off, and interpolates
# them for every service before a profile is applied.
GLITCHTIP_POSTGRES_PASSWORD={{ stack_secrets.glitchtip_db }}
GLITCHTIP_SECRET_KEY={{ stack_secrets.glitchtip_key }}
GLITCHTIP_DOMAIN={{ 'http://' ~ stack_ts_dns ~ ':8000' if stack.glitchtip else 'http://glitchtip-not-in-this-stack.invalid' }}
