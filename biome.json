{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!**/migrations",
            "!**/backups",
            "!**/.expo",
            "!.claude",
            "!.impeccable",
            "!packages/app/android",
            "!packages/app/ios"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 110
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "error"
            },
            "style": {
                "useImportType": "error",
                "noRestrictedImports": {
                    "level": "error",
                    "options": {
                        "paths": {
                            "react": {
                                "importNames": ["useEffect"],
                                "message": "useEffect is not allowed by default. Most of what it gets reached for belongs somewhere else: derive it during render, do it in the event handler that caused it, or key the component to reset it. It is the right tool for synchronising with something outside React — a timer, an animation, a native listener, a subscription. If that is what you have, say which one and suppress this on the import: // biome-ignore lint/style/noRestrictedImports: <the reason>"
                            }
                        }
                    }
                }
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
