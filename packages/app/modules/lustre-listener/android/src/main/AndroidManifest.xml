<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>
        <service
            android:name="expo.modules.lustrelistener.LustreListenerService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the clinic phones connected to the clinic's own server, which has no push service: the desk phone is told the moment the doctor finishes with a patient, and the doctor can finish the visit in the chair from its notification." />
        </service>
    </application>
</manifest>
