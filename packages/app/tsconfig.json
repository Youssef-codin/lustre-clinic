{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        // `@mawid/shared` is source, not a build artefact, and its own files
        // import each other with explicit `.ts` extensions. The first app file
        // to import the contract pulls those in. See BLOCKED.md.
        "allowImportingTsExtensions": true
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", ".expo", "dist"]
}
