{
    "name": "@lustre/app",
    "version": "0.0.0",
    "private": true,
    "main": "index.ts",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "device": "bash scripts/device.sh",
        "device:build": "bash scripts/device.sh --build",
        "device:start": "bash scripts/device.sh --start",
        "device:logs": "adb logcat -s ReactNativeJS:V ReactNative:V",
        "device:stop": "cd android && ./gradlew --stop",
        "emu": "bash scripts/emulator.sh",
        "emu:build": "bash scripts/emulator.sh --build",
        "emu:start": "bash scripts/emulator.sh --start",
        "emu:shot": "bash scripts/emulator.sh --shot",
        "ios": "expo run:ios",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@expo-google-fonts/dm-mono": "^0.4.2",
        "@expo-google-fonts/instrument-sans": "^0.4.2",
        "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
        "@expo/vector-icons": "^15.1.1",
        "@gorhom/bottom-sheet": "^5.2.14",
        "@lustre/shared": "workspace:*",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-community/datetimepicker": "9.1.0",
        "@tanstack/react-query": "^5.101.4",
        "@trpc/client": "11.18.0",
        "@trpc/server": "11.18.0",
        "@trpc/tanstack-react-query": "11.18.0",
        "expo": "~57.0.9",
        "expo-constants": "^57.0.9",
        "expo-dev-client": "^57.0.10",
        "expo-font": "~57.0.1",
        "expo-notifications": "^57.0.15",
        "expo-status-bar": "~57.0.1",
        "lucide-react-native": "^1.31.0",
        "react": "19.2.3",
        "react-native": "0.86.2",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-svg": "15.15.4",
        "react-native-worklets": "0.10.1"
    },
    "devDependencies": {
        "@lustre/server": "workspace:*",
        "@types/react": "~19.2.2",
        "react-native-svg-transformer": "^1.5.3"
    }
