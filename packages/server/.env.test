# Loaded before any test file, by tests/preload.ts via bunfig.toml — so a bare
# `bun test` is safe too, not only `bun run test`.
#
# The suite truncates every table between tests, so it runs against its own
# database and `tests/helpers/db.ts` refuses to start unless the name ends in
# `_test`. Create it once:
#
#   docker compose exec db createdb -U lustre lustre_test
DATABASE_URL=postgres://lustre:lustre@localhost:5432/lustre_test
LOG_LEVEL=silent

# Empty so migrations run against DATABASE_URL above, which the suite checks is a
# `_test` database and not one marked production. An inherited
# MIGRATION_DATABASE_URL would otherwise send the suite's migrations somewhere
# neither guard looks.
MIGRATION_DATABASE_URL=

# A scratch directory of its own, not the default `./backups`. The Drive grant a
# phone sign-in writes is a FILE, not an env var, so blanking the variables below
# is not enough on its own — a real `drive-grant.json` sitting in a developer's
# backup directory would hand the suite a live Drive client (SPEC §16).
BACKUP_DIR=./backups/test-scratch

# Left empty deliberately. `offsiteDestination()` must stay null so no test run
# can reach a real Drive folder or S3 bucket (SPEC §16).
BACKUP_DRIVE_FOLDER_ID=
BACKUP_DRIVE_OAUTH_CLIENT_ID=
BACKUP_DRIVE_OAUTH_CLIENT_SECRET=
BACKUP_DRIVE_REFRESH_TOKEN=
BACKUP_DRIVE_ANDROID_CLIENT_ID=
BACKUP_DRIVE_CLIENT_EMAIL=
BACKUP_DRIVE_PRIVATE_KEY=
BACKUP_DRIVE_SUBJECT=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Nothing may post to Discord or ping a monitor from a test run (SPEC §17).
DISCORD_WEBHOOK_URL=
HEARTBEAT_URL=
