# Loaded before any test file, by tests/preload.ts via bunfig.toml — so a bare
# `bun test` is safe too, not only `bun run test`.
#
# The suite truncates every table between tests, so it runs against its own
# database and `tests/helpers/db.ts` refuses to start unless the name ends in
# `_test`. Create it once:
#
#   docker compose exec db createdb -U mawid mawid_test
DATABASE_URL=postgres://mawid:mawid@localhost:5432/mawid_test
LOG_LEVEL=silent

# Left empty deliberately. `offsiteDestination()` must stay null so no test run
# can reach a real Drive folder or S3 bucket (SPEC §16).
BACKUP_DRIVE_FOLDER_ID=
BACKUP_DRIVE_CLIENT_EMAIL=
BACKUP_DRIVE_PRIVATE_KEY=
BACKUP_DRIVE_SUBJECT=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Nothing may post to Discord or ping a monitor from a test run (SPEC §17).
DISCORD_WEBHOOK_URL=
HEARTBEAT_URL=
