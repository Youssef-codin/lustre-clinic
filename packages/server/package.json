{
    "name": "@mawid/server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --watch src/server.ts",
        "start": "bun src/server.ts",
        "build": "bun build --compile --asset-naming=\"[name].[ext]\" --outfile dist/mawid src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "LOG_LEVEL=silent bun test",
        "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
        "db:migrate": "bun run scripts/migrate.ts"
    },
    "dependencies": {
        "@mawid/shared": "workspace:*",
        "@pdf-lib/fontkit": "^1.1.1",
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "bidi-js": "^1.0.3",
        "drizzle-orm": "^0.45.2",
        "express": "^5.1.0",
        "harfbuzzjs": "^1.5.0",
        "helmet": "^8.1.0",
        "pdf-lib": "^1.17.1",
        "pino": "^10.0.0",
        "pino-pretty": "^13.1.2",
        "qrcode": "^1.5.4",
        "ws": "^8.19.0",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/qrcode": "^1.5.6",
        "@types/supertest": "^6.0.3",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.10",
        "supertest": "^7.1.4"
    }
}
