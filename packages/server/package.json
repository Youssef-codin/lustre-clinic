{
    "name": "@mawid/server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun --env-file=../../.env --watch src/index.ts",
        "start": "bun --env-file=../../.env src/index.ts",
        "typecheck": "tsc --noEmit",
        "test": "LOG_LEVEL=silent bun test --env-file=../../.env",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun --env-file=../../.env scripts/migrate.ts",
        "db:seed": "bun --env-file=../../.env scripts/seed.ts",
        "backup": "bun --env-file=../../.env scripts/backup.ts",
        "restore": "bun --env-file=../../.env scripts/restore.ts"
    },
    "dependencies": {
        "@mawid/shared": "workspace:*",
        "@trpc/server": "^11.0.0",
        "drizzle-orm": "^0.45.2",
        "pino": "^10.0.0",
        "postgres": "^3.4.5",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@trpc/client": "^11.18.0",
        "drizzle-kit": "^0.31.10",
        "pino-pretty": "^13.1.2"
    }
}
